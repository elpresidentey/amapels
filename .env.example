# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/amapels-ng

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Paystack Configuration
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# Resend (Email)
RESEND_API_KEY=your-resend-api-key
# Optional: pin the audience used for newsletter contacts. When omitted, the
# app looks for an audience named AMAPELS and creates one on first signup.
RESEND_AUDIENCE_ID=

# Public site URL (used for canonical URLs and Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://amapelsng.com

# Admin Credentials
ADMIN_EMAIL=admin@amapels.com
ADMIN_PASSWORD=your-secure-password

# Shopify Headless Backend (fac0fc-10.myshopify.com)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=fac0fc-10.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token
SHOPIFY_API_VERSION=2025-10

# Auth Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SECRET_KEY=your-admin-hmac-secret-key
JWT_SECRET=your-customer-session-secret-key
