# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/amapels-ng

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Paystack Configuration
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# Resend (Email)
RESEND_API_KEY=your-resend-api-key

# Admin Credentials
ADMIN_EMAIL=admin@amapels.com
ADMIN_PASSWORD=your-secure-password

# Auth Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SECRET_KEY=your-admin-hmac-secret-key
JWT_SECRET=your-customer-session-secret-key
